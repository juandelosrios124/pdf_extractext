# Application
APP_NAME=PDF Extract API
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development

# MongoDB — nombre del servicio en Docker Compose
MONGODB_URL=mongodb://mongodb:27017
MONGODB_DB_NAME=pdf_extract_db

# Auth
SECRET_KEY=ebcf419bb6c131efa2c351c7dcb6e4ebe32bf063f78b2a7f92b281095885c913

# Logging
LOG_LEVEL=INFO

# File Upload (bytes) — 50MB por defecto
MAX_UPLOAD_SIZE=52428800


# CORS (JSON array format)
ALLOWED_HOSTS=["http://localhost:3000","http://localhost:8000"]

# Logging Configuration
# Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Format: text (for dev), json (for production)
LOG_FORMAT=text

# Enable correlation IDs for distributed tracing
LOG_CORRELATION_ID=true

# Ollama
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:1.5b

# extract_service en docker-compose (los lee Compose, no la app)
# Réplicas: la consigna permite hasta 5
EXTRACT_REPLICAS=5
# Límites por réplica: máx. 1.0 CPU y entre 512m y 1g de RAM
EXTRACT_CPUS=1.0
EXTRACT_MEMORY=1g
EXTRACT_MAX_UPLOAD_SIZE=52428800
EXTRACT_THREAD_POOL_SIZE=4
EXTRACT_LOG_LEVEL=INFO

# Reverse proxy (Caddy) delante de extract. Los timeouts influyen en los
# resultados de las pruebas de carga: ver proxy/README.md
PROXY_PORT=8001
PROXY_DIAL_TIMEOUT=5s
PROXY_RESPONSE_TIMEOUT=60s
PROXY_TRY_DURATION=5s
PROXY_READ_BODY_TIMEOUT=30s
PROXY_WRITE_TIMEOUT=2m
PROXY_IDLE_TIMEOUT=2m